DEEPSEEK_API_KEY=your_deepseek_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: enables OpenAI embeddings for RAG (text-embedding-3-small).
# Without it, a local HuggingFace model (BAAI/bge-small-zh-v1.5) is used instead.
OPENAI_API_KEY=

# Optional: enables LangSmith tracing for the whole pipeline.
LANGCHAIN_API_KEY=
